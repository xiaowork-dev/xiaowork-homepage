{
  "name": "xiaowork-homepage",
  "version": "1.0.0-p5a",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "nuxt dev --host 127.0.0.1 --port 3100",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview --host 127.0.0.1",
    "postinstall": "nuxt prepare",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "nuxt typecheck",
    "smoke": "node scripts/smoke.mjs",
    "test": "node --test scripts/*.test.mjs",
    "admin:check": "npm --prefix admin run check",
    "admin:test": "npm --prefix admin test",
    "admin:build": "npm --prefix admin run build",
    "admin:e2e": "node scripts/admin-browser-test.mjs",
    "check": "npm run lint && npm run format:check && npm run typecheck"
  },
  "dependencies": {
    "nuxt": "4.6.2",
    "vue": "3.5.44",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@nuxt/eslint": "1.17.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vue-tsc": "3.3.13"
  }
}
