# Host interface and port. Keep loopback when using a host-based reverse proxy.
BIND_ADDRESS=127.0.0.1
HTTP_PORT=3100
# Local image tag. Deploy/update scripts override it with an explicit release tag.
IMAGE_TAG=p5a-local
# Build-time public origin for canonical URLs, sharing and sitemap.
# Leave empty until the real domain is confirmed. Changing it requires a new image tag/build.
NUXT_PUBLIC_SITE_URL=
# Only for compose.proxy.yaml: the existing shared network and a unique service alias.
# Never guess production names; obtain them before P5-B.
PROXY_NETWORK=
PROXY_SERVICE_ALIAS=
