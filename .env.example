# Current production: 1Panel/OpenResty on the same host, forwarding to loopback.
# Keep 127.0.0.1:3100; never change this to 0.0.0.0 or a public IP for production.
BIND_ADDRESS=127.0.0.1
HTTP_PORT=3100
# Local image tag. Deploy/update scripts override it with an explicit release tag.
IMAGE_TAG=p5a-local
# Build-time public origin for canonical URLs, sharing and sitemap.
# Production is https://xiaoworks.com (no www); set it in the untracked deployment .env.
# Kept empty here for safe local defaults. Changing it requires a new image tag/build.
NUXT_PUBLIC_SITE_URL=
# Legacy/optional compose.proxy.yaml only; not used by current 1Panel/OpenResty production.
# Keep these empty with compose.yaml. Do not attach Homepage to the NPM network.
PROXY_NETWORK=
PROXY_SERVICE_ALIAS=
